{
  "name": "@turboterp/campus-data",
  "version": "0.1.0",
  "private": true,
  "description": "Fetchers and parsers for UMD campus data (dining, libraries, RecWell, Shuttle-UM). Framework-free so the web app and a future iOS app can share it.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./buildings": "./src/buildings.ts",
    "./buses": "./src/buses.ts",
    "./dates": "./src/dates.ts",
    "./hours": "./src/hours.ts",
    "./http": "./src/http.ts",
    "./snapshots": "./src/snapshots/index.ts",
    "./trip": "./src/trip.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts",
    "snapshots": "node scripts/build-snapshots.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
