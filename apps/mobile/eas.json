{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": { "image": "latest", "simulator": false },
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "image": "latest" },
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": { "image": "latest" }
    }
  },
  "submit": { "production": {} }
}
