{
  "name": "@turboterp/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs && node scripts/copy-tesseract-assets.mjs && node scripts/copy-pdfjs-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "ui-check": "node scripts/ui-check.mjs",
    "ui-gallery": "node scripts/ui-gallery.mjs",
    "test": "vitest run",
    "advisor-data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/advisor-data.mts"
  },
  "dependencies": {
    "@turboterp/audit": "*",
    "@turboterp/campus-data": "*",
    "@turboterp/course-data": "*",
    "@turboterp/credit": "*",
    "@turboterp/plan": "*",
    "@turboterp/programs": "*",
    "@turboterp/ratings": "*",
    "@turboterp/tracks": "*",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.6",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
